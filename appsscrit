// Adds new customer columns without changing or rewriting any existing row.
function ensureCustomerColumns(sheet) {
  var required = ["ID", "Customer Name", "Guardian Name", "Gender", "DOB", "Religion", "Aadhaar No", "Mobile No", "Address", "District", "State", "PIN Code", "Vehicle", "Vehicle Company", "Vehicle Model", "Chassis Number", "Engine Number", "Occupation", "Photo URL"];
  var lastColumn = sheet.getLastColumn();
  if (lastColumn === 0) {
    sheet.getRange(1, 1, 1, required.length).setValues([required]);
    return;
  }
  var headers = sheet.getRange(1, 1, 1, lastColumn).getDisplayValues()[0].map(function(h) { return String(h).trim(); });
  // Rename the old PIN header without touching its existing values.
  var oldPinIndex = headers.indexOf("PIN");
  if (oldPinIndex !== -1 && headers.indexOf("PIN Code") === -1) {
    sheet.getRange(1, oldPinIndex + 1).setValue("PIN Code");
    headers[oldPinIndex] = "PIN Code";
  }
  // Remove empty duplicate headers created by earlier versions.
  for (var col = headers.length - 1; col >= 0; col--) {
    if (!headers[col] || headers.indexOf(headers[col]) !== col) {
      var duplicateValues = sheet.getRange(2, col + 1, Math.max(sheet.getLastRow() - 1, 1), 1).getDisplayValues();
      var hasData = duplicateValues.some(function(row) { return String(row[0]).trim() !== ""; });
      if (!hasData) { sheet.deleteColumn(col + 1); headers.splice(col, 1); }
    }
  }
  required.forEach(function(header) {
    if (headers.indexOf(header) === -1) {
      sheet.getRange(1, sheet.getLastColumn() + 1).setValue(header);
      headers.push(header);
    }
  });
}

function customerRowValues(sheet, data, id, photoUrl) {
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];
  var values = {
    "ID": id, "Customer Name": data.customerName, "Guardian Name": data.guardianName,
    "Gender": data.gender, "DOB": data.dob, "Religion": data.religion,
    "Aadhaar No": data.aadhaarNo, "Mobile No": data.mobileNo, "Address": data.address,
    "District": data.district, "State": data.state, "PIN Code": data.pin, "Vehicle": data.vehicle,
    "Vehicle Company": data.vehicleCompany, "Vehicle Model": data.vehicleModel,
    "Chassis Number": data.chassisNo, "Engine Number": data.engineNo,
    "Occupation": data.occupation, "Photo URL": photoUrl
  };
  return headers.map(function(header) { return values[String(header).trim()] !== undefined ? values[String(header).trim()] : ""; });
}

function appendCustomerByHeaders(sheet, data, id, photoUrl) {
  sheet.appendRow(customerRowValues(sheet, data, id, photoUrl));
}

function updateCustomerByHeaders(sheet, rowNumber, data, photoUrl) {
  var row = customerRowValues(sheet, data, data.id, photoUrl);
  sheet.getRange(rowNumber, 1, 1, row.length).setValues([row]);
}

function getOrCreateSheet(ss, name, headers) {
  var sheet = ss.getSheetByName(name);
  if (!sheet) { sheet = ss.insertSheet(name); sheet.appendRow(headers); }
  return sheet;
}

function seedDropdownDefaults(sheet) {
  var defaults = {
    "Company Name": ["YAKUZA", "KOMAKI", "OKINAVA"],
    "Model": ["CHERRY", "Y1", "DUSTER"],
    "Bank Name": ["State Bank of India", "HDFC Bank"]
  };
  var rows = sheet.getDataRange().getValues();
  Object.keys(defaults).forEach(function(type) { defaults[type].forEach(function(value) {
    var exists = rows.slice(1).some(function(r) { return String(r[1]) === type && String(r[2]).trim().toLowerCase() === value.toLowerCase(); });
    if (!exists) { sheet.appendRow(["DD-" + new Date().getTime() + "-" + Math.floor(Math.random()*1000), type, value, new Date()]); rows = sheet.getDataRange().getValues(); }
  }); });
}

function getOrCreatePartsSheet(ss, name) {
  var sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    sheet.appendRow(["ID", "Date", "Product Name", "Serial No", "Quantity", "Price", "CGST", "SGST", "Amount"]);
  }
  return sheet;
}

function sheetObjectsToRows(sheet) {
  var values = sheet.getDataRange().getDisplayValues();
  var result = [];
  if (values.length < 2) return result;
  for (var i = 1; i < values.length; i++) {
    var obj = {};
    for (var j = 0; j < values[0].length; j++) obj[String(values[0][j]).trim()] = values[i][j];
    result.push(obj);
  }
  return result;
}

function jsonResponse(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function getDropdownData(sheet) {
  var rows = sheet.getDataRange().getDisplayValues(), out = [];
  for (var i = 1; i < rows.length; i++) out.push({ID: rows[i][0], Type: rows[i][1], Value: rows[i][2], "Created At": rows[i][3]});
  return out;
}
