function deleteExpiredBranchMessages(sheet, now) {
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return;
  var cutoff = now.getTime() - 72 * 60 * 60 * 1000;
  var timestamps = sheet.getRange(2, 2, lastRow - 1, 1).getValues();
  for (var i = timestamps.length - 1; i >= 0; i--) {
    var timestamp = timestamps[i][0];
    var timestampMs = timestamp instanceof Date ? timestamp.getTime() : new Date(timestamp).getTime();
    if (!isNaN(timestampMs) && timestampMs < cutoff) sheet.deleteRow(i + 2);
  }
}

function installBranchMessageCleanupTrigger() {
  var hasCleanupTrigger = ScriptApp.getProjectTriggers().some(function(trigger) {
    return trigger.getHandlerFunction() === "cleanupExpiredBranchMessages";
  });
  if (!hasCleanupTrigger) ScriptApp.newTrigger("cleanupExpiredBranchMessages").timeBased().everyMinutes(15).create();
  return hasCleanupTrigger ? "Cleanup trigger already installed." : "Cleanup trigger installed.";
}

function cleanupExpiredBranchMessages() {
  var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = spreadsheet && spreadsheet.getSheetByName("Branch Messages");
  if (sheet) deleteExpiredBranchMessages(sheet, new Date());
}

// Add a Branch column without changing existing records; old records stay under Main Branch.
function ensureBranchColumn(sheet) {
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0].map(function(h) { return String(h).trim(); });
  var branchIndex = headers.indexOf("Branch");
  if (branchIndex === -1) {
    branchIndex = headers.length;
    sheet.getRange(1, branchIndex + 1).setValue("Branch");
  }
  var lastRow = sheet.getLastRow();
  if (lastRow > 1) {
    var range = sheet.getRange(2, branchIndex + 1, lastRow - 1, 1);
    var values = range.getValues();
    var changed = false;
    values.forEach(function(row) { if (!String(row[0] || "").trim()) { row[0] = "Main Branch"; changed = true; } });
    if (changed) range.setValues(values);
  }
}

function sheetObjectsToRows(sheet) {
  var values = sheet.getDataRange().getDisplayValues();
  var result = [];
  if (values.length < 2) return result;
  for (var i = 1; i < values.length; i++) {
    var obj = {};
    for (var j = 0; j < values[0].length; j++) obj[String(values[0][j]).trim()] = values[i][j];
    result.push(obj);
  }
  return result;
}

function jsonResponse(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function normalizeBillDuplicateValue(value, numeric) {
  if (numeric) {
    var parsed = parseFloat(String(value == null ? "" : value).replace(/[^0-9.-]+/g, ""));
    return isNaN(parsed) ? "0" : String(parsed);
  }
  return String(value == null ? "" : value).trim().toLowerCase();
}
function ensureBillColourColumn(sheet) {
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0].map(function(header) { return String(header).trim(); });
  if (headers.indexOf("Vehicle Colour") === -1) sheet.getRange(1, headers.length + 1).setValue("Vehicle Colour");
}
function sameBillForDuplicate(row, data, branch) {
  var fields = [
    [1, data.custId], [2, data.customerName], [3, data.item], [4, data.vehicleCompany],
    [5, data.vehicleModel], [6, data.hsn], [7, data.chassisNo], [8, data.engineNo],
    [9, data.quantity, true], [10, data.rate, true], [11, data.amount, true],
    [12, data.sgst, true], [13, data.cgst, true], [14, data.igst, true], [15, data.totalAmount, true],
    [16, data.batteryDetails], [17, data.batteryWarranty], [18, data.batterySerialNo],
    [19, data.charger], [20, data.chargerSerialNo], [21, data.bankName], [22, data.bankIfsc],
    [23, data.bankAccName], [24, data.bankAccNo], [25, data.bankBranch]
  ];
  fields.push([28, data.vehicleColour]);
  if (normalizeBillDuplicateValue(row[27], false) !== normalizeBillDuplicateValue(branch, false)) return false;
  return fields.every(function(field) { return normalizeBillDuplicateValue(row[field[0]], field[2]) === normalizeBillDuplicateValue(field[1], field[2]); });
}
function filterRowsByBranch(rows, branch) {
  return (rows || []).filter(function(row) { return normalizeBranch(row.Branch) === branch; });
}
function isMainBranch(branch) { return String(branch || "").trim().toLowerCase() === "main branch"; }

