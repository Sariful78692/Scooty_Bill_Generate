// Adds new customer columns without changing or rewriting any existing row.
function ensureCustomerColumns(sheet) {
  var required = ["ID", "Customer Name", "Guardian Name", "Gender", "DOB", "Religion", "Aadhaar No", "Mobile No", "Address", "District", "State", "PIN Code", "Vehicle", "Vehicle Company", "Vehicle Model", "Chassis Number", "Engine Number", "Occupation", "Photo URL", "Branch"];
  var lastColumn = sheet.getLastColumn();
  if (lastColumn === 0) {
    sheet.getRange(1, 1, 1, required.length).setValues([required]);
    return;
  }
  var headers = sheet.getRange(1, 1, 1, lastColumn).getDisplayValues()[0].map(function(h) { return String(h).trim(); });
  // Rename the old PIN header without touching its existing values.
  var oldPinIndex = headers.indexOf("PIN");
  if (oldPinIndex !== -1 && headers.indexOf("PIN Code") === -1) {
    sheet.getRange(1, oldPinIndex + 1).setValue("PIN Code");
    headers[oldPinIndex] = "PIN Code";
  }
  // Remove empty duplicate headers created by earlier versions.
  for (var col = headers.length - 1; col >= 0; col--) {
    if (!headers[col] || headers.indexOf(headers[col]) !== col) {
      var duplicateValues = sheet.getRange(2, col + 1, Math.max(sheet.getLastRow() - 1, 1), 1).getDisplayValues();
      var hasData = duplicateValues.some(function(row) { return String(row[0]).trim() !== ""; });
      if (!hasData) { sheet.deleteColumn(col + 1); headers.splice(col, 1); }
    }
  }
  required.forEach(function(header) {
    if (headers.indexOf(header) === -1) {
      sheet.getRange(1, sheet.getLastColumn() + 1).setValue(header);
      headers.push(header);
    }
  });
}

function customerRowValues(sheet, data, id, photoUrl) {
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];
  var values = {
    "ID": id, "Customer Name": data.customerName, "Guardian Name": data.guardianName,
    "Gender": data.gender, "DOB": data.dob, "Religion": data.religion,
    "Aadhaar No": data.aadhaarNo, "Mobile No": data.mobileNo, "Address": data.address,
    "District": data.district, "State": data.state, "PIN Code": data.pin, "Vehicle": data.vehicle,
    "Vehicle Company": data.vehicleCompany, "Vehicle Model": data.vehicleModel,
    "Chassis Number": data.chassisNo, "Engine Number": data.engineNo,
    "Occupation": data.occupation, "Photo URL": photoUrl, "Branch": normalizeBranch(data.branch)
  };
  return headers.map(function(header) { return values[String(header).trim()] !== undefined ? values[String(header).trim()] : ""; });
}

function appendCustomerByHeaders(sheet, data, id, photoUrl) {
  sheet.appendRow(customerRowValues(sheet, data, id, photoUrl));
}

function updateCustomerByHeaders(sheet, rowNumber, data, photoUrl) {
  var row = customerRowValues(sheet, data, data.id, photoUrl);
  sheet.getRange(rowNumber, 1, 1, row.length).setValues([row]);
}

function getOrCreateSheet(ss, name, headers) {
  var sheet = ss.getSheetByName(name);
  if (!sheet) { sheet = ss.insertSheet(name); sheet.appendRow(headers); }
  return sheet;
}

function seedDropdownDefaults(sheet) {
  var defaults = {
    "Company Name": ["YAKUZA", "KOMAKI", "OKINAVA"],
    "Model": ["CHERRY", "Y1", "DUSTER"],
    "Bank Name": ["State Bank of India", "HDFC Bank"]
  };
  var rows = sheet.getDataRange().getValues();
  Object.keys(defaults).forEach(function(type) { defaults[type].forEach(function(value) {
    var exists = rows.slice(1).some(function(r) { return String(r[1]) === type && String(r[2]).trim().toLowerCase() === value.toLowerCase(); });
    if (!exists) { sheet.appendRow(["DD-" + new Date().getTime() + "-" + Math.floor(Math.random()*1000), type, value, new Date()]); rows = sheet.getDataRange().getValues(); }
  }); });
}

function getOrCreatePartsSheet(ss, name) {
  var sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    sheet.appendRow(["ID", "Date", "Product Name", "Serial No", "Quantity", "Price", "CGST", "SGST", "Amount", "Branch"]);
  }
  return sheet;
}

function normalizeBranch(value) { return String(value || "Main Branch").trim() || "Main Branch"; }

// Add a Branch column without changing existing records; old records stay under Main Branch.
function ensureBranchColumn(sheet) {
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0].map(function(h) { return String(h).trim(); });
  var branchIndex = headers.indexOf("Branch");
  if (branchIndex === -1) {
    branchIndex = headers.length;
    sheet.getRange(1, branchIndex + 1).setValue("Branch");
  }
  var lastRow = sheet.getLastRow();
  if (lastRow > 1) {
    var range = sheet.getRange(2, branchIndex + 1, lastRow - 1, 1);
    var values = range.getValues();
    var changed = false;
    values.forEach(function(row) { if (!String(row[0] || "").trim()) { row[0] = "Main Branch"; changed = true; } });
    if (changed) range.setValues(values);
  }
}

function sheetObjectsToRows(sheet) {
  var values = sheet.getDataRange().getDisplayValues();
  var result = [];
  if (values.length < 2) return result;
  for (var i = 1; i < values.length; i++) {
    var obj = {};
    for (var j = 0; j < values[0].length; j++) obj[String(values[0][j]).trim()] = values[i][j];
    result.push(obj);
  }
  return result;
}

function jsonResponse(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function filterRowsByBranch(rows, branch) {
  return (rows || []).filter(function(row) { return normalizeBranch(row.Branch) === branch; });
}
function isMainBranch(branch) { return String(branch || "").trim().toLowerCase() === "main branch"; }

function ensureBranchUserSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Branch Users");
  if (!sheet) {
    sheet = ss.insertSheet("Branch Users");
    sheet.appendRow(["Branch", "Username", "Password"]);
  }
  if (sheet.getRange(1, 3).getDisplayValue() !== "Password") sheet.getRange(1, 3).setValue("Password");
  if (sheet.getLastRow() < 2) sheet.appendRow(["Main Branch", "admin", "admin123"]);
  return sheet;
}

function branchLogin(data) {
  var sheet = ensureBranchUserSheet();
  var rows = sheet.getDataRange().getDisplayValues();
  var username = String(data.username || "").trim();
  var password = String(data.password || "");
  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][1]).trim() === username && (String(rows[i][2]) === password || String(rows[i][2]) === hashBranchPassword(password))) {
      // Migrate legacy SHA-256 entries to the requested readable sheet value after a successful login.
      if (String(rows[i][2]) === hashBranchPassword(password)) sheet.getRange(i + 1, 3).setValue(password);
      var token = Utilities.getUuid() + Utilities.getUuid();
      CacheService.getScriptCache().put("branch_session_" + token, String(rows[i][0]).trim(), 21600);
      return jsonResponse({status:"success", token:token, branch:String(rows[i][0]).trim()});
    }
  }
  return jsonResponse({status:"error", message:"Invalid branch ID or password"});
}

function getAuthenticatedBranch(token) {
  if (!token) return "";
  return CacheService.getScriptCache().get("branch_session_" + String(token)) || "";
}

function hashBranchPassword(password) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(password), Utilities.Charset.UTF_8);
  return bytes.map(function(b) { var value = (b < 0 ? b + 256 : b).toString(16); return value.length === 1 ? "0" + value : value; }).join("");
}

// Run this from the Apps Script editor to add a branch login or reset its credentials.
function createOrUpdateBranchUser() {
  var ui = SpreadsheetApp.getUi();
  var branchPrompt = ui.prompt("New branch", "Branch name:", ui.ButtonSet.OK_CANCEL);
  if (branchPrompt.getSelectedButton() !== ui.Button.OK) return;
  var branch = branchPrompt.getResponseText().trim();
  var usernamePrompt = ui.prompt("New branch", "Login ID:", ui.ButtonSet.OK_CANCEL);
  if (usernamePrompt.getSelectedButton() !== ui.Button.OK) return;
  var username = usernamePrompt.getResponseText().trim();
  var passwordPrompt = ui.prompt("New branch", "Password:", ui.ButtonSet.OK_CANCEL);
  if (passwordPrompt.getSelectedButton() !== ui.Button.OK) return;
  var password = passwordPrompt.getResponseText();
  if (!branch || !username || !password) { ui.alert("Branch, login ID and password are required."); return; }
  var users = ensureBranchUserSheet();
  var existing = users.getDataRange().getDisplayValues().slice(1);
  var existingBranchRow = -1;
  for (var i = 0; i < existing.length; i++) {
    if (String(existing[i][0]).trim().toLowerCase() === branch.toLowerCase()) existingBranchRow = i + 2;
    else if (String(existing[i][1]).trim().toLowerCase() === username.toLowerCase()) { ui.alert("That login ID is already used by another branch."); return; }
  }
  if (existingBranchRow > 0) users.getRange(existingBranchRow, 2, 1, 2).setValues([[username, password]]);
  else users.appendRow([branch, username, password]);
  var branchSheet = getOrCreateSheet(SpreadsheetApp.getActiveSpreadsheet(), "Branches", ["Branch"]);
  if (!branchSheet.getDataRange().getDisplayValues().some(function(row, index) { return index > 0 && String(row[0]).trim().toLowerCase() === branch.toLowerCase(); })) branchSheet.appendRow([branch]);
  ui.alert("Branch login created for " + branch + ".");
}

function getDropdownData(sheet) {
  var rows = sheet.getDataRange().getDisplayValues(), out = [];
  for (var i = 1; i < rows.length; i++) out.push({ID: rows[i][0], Type: rows[i][1], Value: rows[i][2], "Created At": rows[i][3]});
  return out;
}
