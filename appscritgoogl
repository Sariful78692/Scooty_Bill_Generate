function doGet(e) {
  var authBranch = getAuthenticatedBranch(e && e.parameter ? e.parameter.token : "");
  if (!authBranch) return jsonResponse({status:"error", message:"Session expired. Please log in again."});
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var custSheet = ss.getSheets()[0];
  ensureCustomerColumns(custSheet);
  ensureBranchColumn(custSheet);
  var billSheet = getOrCreateBillSheet(ss);
  ensureBranchColumn(billSheet);
  var dropdownSheet = getOrCreateSheet(ss, "Dropdown", ["ID", "Type", "Value", "Created At"]);
  var purchaseSheet = getOrCreatePartsSheet(ss, "Parts Purchases");
  var saleSheet = getOrCreatePartsSheet(ss, "Parts Sales");
  ensureBranchColumn(purchaseSheet);
  ensureBranchColumn(saleSheet);
  var branchSheet = getOrCreateSheet(ss, "Branches", ["Branch"]);
  if (branchSheet.getLastRow() < 2) branchSheet.appendRow(["Main Branch"]);
  seedDropdownDefaults(dropdownSheet);

  var custData = custSheet.getDataRange().getDisplayValues();
  var custResult = [];

  if (custData.length > 1) {
    var custHeaders = custData[0];

    for (var i = 1; i < custData.length; i++) {
      var custObj = {};

      for (var j = 0; j < custHeaders.length; j++) {
        custObj[String(custHeaders[j]).trim()] = custData[i][j];
      }

      custResult.push(custObj);
    }
  }

  var billData = billSheet.getDataRange().getDisplayValues();
  var billResult = [];

  if (billData.length > 1) {
    var billHeaders = billData[0];

    for (var x = 1; x < billData.length; x++) {
      var billObj = {};

      for (var y = 0; y < billHeaders.length; y++) {
        billObj[String(billHeaders[y]).trim()] = billData[x][y];
      }

      billResult.push(billObj);
    }
  }

  var purchaseResult = sheetObjectsToRows(purchaseSheet);
  var saleResult = sheetObjectsToRows(saleSheet);

  return ContentService
    .createTextOutput(JSON.stringify({
      customers: isMainBranch(authBranch) ? custResult : filterRowsByBranch(custResult, authBranch),
      bills: isMainBranch(authBranch) ? billResult : filterRowsByBranch(billResult, authBranch),
      purchases: filterRowsByBranch(purchaseResult, authBranch),
      sales: filterRowsByBranch(saleResult, authBranch),
      dropdowns: getDropdownData(dropdownSheet),
      branches: branchSheet.getDataRange().getDisplayValues().slice(1).map(function(row) { return String(row[0] || "").trim(); }).filter(Boolean),
      branch: authBranch
    }))
    .setMimeType(ContentService.MimeType.JSON);
}


function doPost(e) {
  try {
    var data = JSON.parse(e.postData.contents);
    if (data.action === "branch_login") return branchLogin(data);
    var authBranch = getAuthenticatedBranch(data.token);
    if (!authBranch) return jsonResponse({status:"error", message:"Session expired. Please log in again."});
    data.branch = authBranch;
    if (data.action === "get_main_branch_credentials" || data.action === "update_main_branch_credentials") {
      if (!isMainBranch(authBranch)) return jsonResponse({status:"error", message:"Only Main Branch can manage these credentials."});
      var mainUsers = ensureBranchUserSheet();
      var mainRows = mainUsers.getDataRange().getDisplayValues();
      var mainRow = -1;
      for (var mi = 1; mi < mainRows.length; mi++) {
        if (String(mainRows[mi][0]).trim().toLowerCase() === "main branch") { mainRow = mi + 1; break; }
      }
      if (mainRow < 0) return jsonResponse({status:"error", message:"Main Branch login was not found."});
      if (data.action === "get_main_branch_credentials") return jsonResponse({status:"success", username:String(mainRows[mainRow - 1][1]).trim(), password:String(mainRows[mainRow - 1][2] || "")});
      var mainUsername = String(data.username || "").trim();
      var mainPassword = String(data.password || "");
      if (!mainUsername || mainUsername.length > 80) return jsonResponse({status:"error", message:"Enter a login ID up to 80 characters."});
      if (mainPassword.length < 6 || mainPassword.length > 128) return jsonResponse({status:"error", message:"Password must be 6 to 128 characters."});
      var mainUsernameTaken = mainRows.slice(1).some(function(row, index) { return index + 2 !== mainRow && String(row[1]).trim().toLowerCase() === mainUsername.toLowerCase(); });
      if (mainUsernameTaken) return jsonResponse({status:"error", message:"That login ID is already in use."});
      mainUsers.getRange(mainRow, 2, 1, 2).setValues([[mainUsername, mainPassword]]);
      return jsonResponse({status:"success"});
    }
    if (data.action === "create_main_branch_user") {
      if (String(authBranch).trim().toLowerCase() !== "main branch") return jsonResponse({status:"error", message:"Only a Main Branch user can create users."});
      var targetBranch = String(data.targetBranch || "").trim();
      var newUsername = String(data.username || "").trim();
      var newPassword = String(data.password || "");
      if (!targetBranch || targetBranch.length > 80) return jsonResponse({status:"error", message:"Enter a branch name up to 80 characters."});
      if (/^[=+@]/.test(targetBranch)) return jsonResponse({status:"error", message:"That branch name is not allowed."});
      if (!newUsername || newUsername.length > 80) return jsonResponse({status:"error", message:"Enter a login ID up to 80 characters."});
      if (newPassword.length < 6 || newPassword.length > 128) return jsonResponse({status:"error", message:"Password must be 6 to 128 characters."});
      var userSheet = ensureBranchUserSheet();
      var userRows = userSheet.getDataRange().getDisplayValues();
      var usernameTaken = userRows.slice(1).some(function(row) { return String(row[1]).trim().toLowerCase() === newUsername.toLowerCase(); });
      if (usernameTaken) return jsonResponse({status:"error", message:"That login ID is already in use. Choose a different login ID."});
      userSheet.appendRow([targetBranch, newUsername, newPassword]);
      var branchesSheet = getOrCreateSheet(SpreadsheetApp.getActiveSpreadsheet(), "Branches", ["Branch"]);
      var knownBranches = branchesSheet.getDataRange().getDisplayValues();
      var branchExists = knownBranches.slice(1).some(function(row) { return String(row[0]).trim().toLowerCase() === targetBranch.toLowerCase(); });
      if (!branchExists) branchesSheet.appendRow([targetBranch]);
      return jsonResponse({status:"success"});
    }
    if (data.action === "list_main_branch_users" || data.action === "update_main_branch_user" || data.action === "delete_main_branch_user") {
      if (!isMainBranch(authBranch)) return jsonResponse({status:"error", message:"Only Main Branch can manage users."});
      var adminUsers = ensureBranchUserSheet();
      var adminRows = adminUsers.getDataRange().getDisplayValues();
      if (data.action === "list_main_branch_users") {
        return jsonResponse({status:"success", users:adminRows.slice(1).map(function(row, index) { return {row:index + 2, branch:String(row[0] || "").trim(), username:String(row[1] || "").trim(), password:String(row[2] || "")}; }).filter(function(user) { return user.branch.toLowerCase() !== "main branch"; })});
      }
      var targetRow = Number(data.row);
      if (!Number.isInteger(targetRow) || targetRow < 2 || targetRow > adminRows.length || String(adminRows[targetRow - 1][0]).trim().toLowerCase() === "main branch") return jsonResponse({status:"error", message:"Branch user not found."});
      if (data.action === "delete_main_branch_user") {
        adminUsers.deleteRow(targetRow);
        return jsonResponse({status:"success"});
      }
      var updatedUsername = String(data.username || "").trim();
      var updatedPassword = String(data.password || "");
      if (!updatedUsername || updatedUsername.length > 80) return jsonResponse({status:"error", message:"Enter a login ID up to 80 characters."});
      if (updatedPassword.length < 6 || updatedPassword.length > 128) return jsonResponse({status:"error", message:"Password must be 6 to 128 characters."});
      var duplicateUsername = adminRows.slice(1).some(function(row, index) { return index + 2 !== targetRow && String(row[1]).trim().toLowerCase() === updatedUsername.toLowerCase(); });
      if (duplicateUsername) return jsonResponse({status:"error", message:"That login ID is already in use."});
      adminUsers.getRange(targetRow, 2, 1, 2).setValues([[updatedUsername, updatedPassword]]);
      return jsonResponse({status:"success"});
    }
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var custSheet = ss.getSheets()[0];
    ensureCustomerColumns(custSheet);
    ensureBranchColumn(custSheet);

    if (data.action === "save_dropdown" || data.action === "update_dropdown" || data.action === "delete_dropdown") {
      var ds = getOrCreateSheet(ss, "Dropdown", ["ID", "Type", "Value", "Created At"]);
      var dr = ds.getDataRange().getValues();
      if (data.action === "save_dropdown") {
        var value = String(data.value || "").trim();
        var duplicate = dr.slice(1).some(function(r) { return String(r[1]).toLowerCase() === String(data.type).toLowerCase() && String(r[2]).trim().toLowerCase() === value.toLowerCase(); });
        if (!value || duplicate) return jsonResponse({status:"error", message: duplicate ? "Value already exists" : "Value is required"});
        var newId = "DD-" + new Date().getTime();
        ds.appendRow([newId, data.type, value, new Date()]);
        return jsonResponse({status:"success", id:newId});
      }
      for (var di = 1; di < dr.length; di++) if (String(dr[di][0]).trim() === String(data.id).trim()) {
        if (data.action === "delete_dropdown") ds.deleteRow(di + 1);
        else {
          var newValue = String(data.value || "").trim();
          var duplicateEdit = dr.slice(1).some(function(r, ri) { return ri !== di - 1 && String(r[1]).toLowerCase() === String(data.type).toLowerCase() && String(r[2]).trim().toLowerCase() === newValue.toLowerCase(); });
          if (!newValue || duplicateEdit) return jsonResponse({status:"error", message: duplicateEdit ? "This value already exists" : "Value is required"});
          ds.getRange(di + 1, 2, 1, 2).setValues([[data.type, newValue]]);
        }
        return jsonResponse({status:"success"});
      }
      return jsonResponse({status:"error", message:"Dropdown record not found"});
    }

    // SAVE BILL
    if (data.action === "save_bill") {
      var billSheet = getOrCreateBillSheet(ss);
      ensureBranchColumn(billSheet);
      var lastRow = billSheet.getLastRow();

      var nextInvNo = 1;

      if (lastRow > 1) {
        var lastInv = billSheet.getRange(lastRow, 1).getValue();

        if (lastInv && String(lastInv).startsWith("INV-")) {
          var numPart = parseInt(String(lastInv).replace("INV-", ""));

          if (!isNaN(numPart)) {
            nextInvNo = numPart + 1;
          }
        } else {
          nextInvNo = lastRow;
        }
      }

      var billId = "INV-" + nextInvNo;

      var formattedDate = Utilities.formatDate(
        new Date(),
        "Asia/Kolkata",
        "dd MMM yyyy"
      );

      billSheet.appendRow([
        billId,
        data.custId,
        data.customerName,
        data.item,
        data.vehicleCompany,
        data.vehicleModel,
        data.hsn,
        data.chassisNo,
        data.engineNo,
        data.quantity,
        data.rate,
        data.amount,
        data.sgst,
        data.cgst,
        data.igst,
        data.totalAmount,
        data.batteryDetails,
        data.batteryWarranty,
        data.batterySerialNo,
        data.charger,
        data.chargerSerialNo,
        data.bankName,
        data.bankIfsc,
        data.bankAccName,
        data.bankAccNo,
        data.bankBranch,
        formattedDate,
        normalizeBranch(data.branch)
      ]);

      return ContentService
        .createTextOutput(JSON.stringify({
          status: "success",
          invoiceNo: billId
        }))
        .setMimeType(ContentService.MimeType.JSON);
    }


    // UPDATE BILL
    if (data.action === "update_bill") {
      if (!isMainBranch(authBranch)) return jsonResponse({status:"error", message:"Only Main Branch can edit bills."});
      var billSheet = getOrCreateBillSheet(ss);
      ensureBranchColumn(billSheet);
      var rows = billSheet.getDataRange().getValues();
      var updated = false;

      for (var i = 1; i < rows.length; i++) {
        if (
          String(rows[i][0]).trim() ===
          String(data.billId).trim()
        ) {
          // Date column is column 27, index 26
          var existingDate = rows[i][26];

          billSheet
            .getRange(i + 1, 1, 1, 28)
            .setValues([[
              data.billId,
              data.custId,
              data.customerName,
              data.item,
              data.vehicleCompany,
              data.vehicleModel,
              data.hsn,
              data.chassisNo,
              data.engineNo,
              data.quantity,
              data.rate,
              data.amount,
              data.sgst,
              data.cgst,
              data.igst,
              data.totalAmount,
              data.batteryDetails,
              data.batteryWarranty,
              data.batterySerialNo,
              data.charger,
              data.chargerSerialNo,
              data.bankName,
              data.bankIfsc,
              data.bankAccName,
              data.bankAccNo,
              data.bankBranch,
              existingDate,
              rows[i][27] || normalizeBranch(data.branch)
            ]]);

          updated = true;
          break;
        }
      }

      return ContentService
        .createTextOutput(JSON.stringify({
          status: updated ? "success" : "error"
        }))
        .setMimeType(ContentService.MimeType.JSON);
    }


    // DELETE BILL
    if (data.action === "delete_bill") {
      if (!isMainBranch(authBranch)) return jsonResponse({status:"error", message:"Only Main Branch can delete bills."});
      var billSheet = getOrCreateBillSheet(ss);
      ensureBranchColumn(billSheet);
      var rows = billSheet.getDataRange().getValues();

      for (var i = 1; i < rows.length; i++) {
        if (
          String(rows[i][0]).trim() ===
          String(data.billId).trim()
        ) {
          billSheet.deleteRow(i + 1);

          return ContentService
            .createTextOutput(JSON.stringify({
              status: "success"
            }))
            .setMimeType(ContentService.MimeType.JSON);
        }
      }

      return ContentService
        .createTextOutput(JSON.stringify({
          status: "error",
          message: "Bill not found"
        }))
        .setMimeType(ContentService.MimeType.JSON);
    }


    // SPARE PARTS TRANSACTIONS
    if (data.action === "save_part_transaction" || data.action === "update_part_transaction" || data.action === "delete_part_transaction") {
      var partSheet = getOrCreatePartsSheet(ss, data.type === "sale" ? "Parts Sales" : "Parts Purchases");
      ensureBranchColumn(partSheet);
      var partRows = partSheet.getDataRange().getValues();
      var idIndex = partRows[0].indexOf("ID");
      if (data.action === "save_part_transaction") {
        var partId = (data.type === "sale" ? "PS-" : "PP-") + new Date().getTime();
        partSheet.appendRow([partId, data.date || "", data.productName || "", data.serialNo || "", data.quantity || 0, data.price || 0, data.cgst || 0, data.sgst || 0, data.amount || 0, normalizeBranch(data.branch)]);
        return jsonResponse({status: "success", id: partId});
      }
      for (var pi = 1; pi < partRows.length; pi++) {
        if (String(partRows[pi][idIndex]).trim() === String(data.id).trim() && normalizeBranch(partRows[pi][9]) === authBranch) {
          if (data.action === "delete_part_transaction") partSheet.deleteRow(pi + 1);
          else partSheet.getRange(pi + 1, 1, 1, 10).setValues([[data.id, data.date || "", data.productName || "", data.serialNo || "", data.quantity || 0, data.price || 0, data.cgst || 0, data.sgst || 0, data.amount || 0, partRows[pi][9] || normalizeBranch(data.branch)]]);
          return jsonResponse({status: "success"});
        }
      }
      return jsonResponse({status: "error", message: "Parts transaction not found"});
    }

    // CUSTOMER PHOTO
    var folderId = "1XaP8aP1-jriVeso5l-eNUku4gmcmQxrp";
    var photoUrl = data.existingPhotoUrl || "";

    if (data.photoBase64 && data.photoName) {
      var folder = DriveApp.getFolderById(folderId);
      var decoded = Utilities.base64Decode(data.photoBase64);

      var blob = Utilities.newBlob(
        decoded,
        data.photoMimeType,
        data.photoName
      );

      var file = folder.createFile(blob);

      file.setSharing(
        DriveApp.Access.ANYONE_WITH_LINK,
        DriveApp.Permission.VIEW
      );

      photoUrl =
        "https://drive.google.com/uc?export=view&id=" +
        file.getId();
    }


    // CREATE CUSTOMER
    if (data.action === "create") {
      var id = "CUST-" + new Date().getTime();
      appendCustomerByHeaders(custSheet, data, id, photoUrl);

      return ContentService
        .createTextOutput(JSON.stringify({
          status: "success",
          id: id,
          photoUrl: photoUrl
        }))
        .setMimeType(ContentService.MimeType.JSON);
    }


    // UPDATE CUSTOMER
    if (data.action === "update") {
      var rows = custSheet.getDataRange().getValues();
      var customerBranchIndex = custSheet.getRange(1, 1, 1, custSheet.getLastColumn()).getDisplayValues()[0].indexOf("Branch");
      var updated = false;

      for (var i = 1; i < rows.length; i++) {
        if (
          String(rows[i][0]).trim() ===
          String(data.id).trim() && normalizeBranch(rows[i][customerBranchIndex]) === authBranch
        ) {
          updateCustomerByHeaders(custSheet, i + 1, data, photoUrl);

          updated = true;
          break;
        }
      }

      return ContentService
        .createTextOutput(JSON.stringify({
          status: updated ? "success" : "error",
          photoUrl: photoUrl
        }))
        .setMimeType(ContentService.MimeType.JSON);
    }


    // DELETE CUSTOMER
    if (data.action === "delete") {
      var rows = custSheet.getDataRange().getValues();
      var customerBranchIndex = custSheet.getRange(1, 1, 1, custSheet.getLastColumn()).getDisplayValues()[0].indexOf("Branch");

      for (var i = 1; i < rows.length; i++) {
        if (
          String(rows[i][0]).trim() ===
          String(data.id).trim() && normalizeBranch(rows[i][customerBranchIndex]) === authBranch
        ) {
          custSheet.deleteRow(i + 1);

          return ContentService
            .createTextOutput(JSON.stringify({
              status: "success"
            }))
            .setMimeType(ContentService.MimeType.JSON);
        }
      }
    }

    return ContentService
      .createTextOutput(JSON.stringify({
        status: "error",
        message: "Invalid action"
      }))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService
      .createTextOutput(JSON.stringify({
        status: "error",
        message: err.toString()
      }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}


