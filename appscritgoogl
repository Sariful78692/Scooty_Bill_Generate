function getAvailableVehicleStock(ss, branch) {
  var stockSheet = ensureVehicleStockSheet(ss);
  var billSheet = getOrCreateBillSheet(ss);
  ensureBranchColumn(billSheet);
  ensureBillColourColumn(billSheet);
  var stocks = sheetObjectsToRows(stockSheet);
  var bills = sheetObjectsToRows(billSheet);
  if (!isMainBranch(branch)) {
    stocks = filterRowsByBranch(stocks, branch);
    bills = filterRowsByBranch(bills, branch);
  }
  return getAvailableVehicleStockFromRows(stocks, bills);
}
function getAvailableVehicleStockFromRows(stocks, bills) {
  var soldIndexes = {};
  bills.forEach(function(bill) {
    if (String(bill.Item || "").trim().toLowerCase().indexOf("scooty") === -1) return;
    var chassis = String(bill["Chassis No"] || "").trim().toLowerCase();
    var company = String(bill["Vehicle Company"] || "").trim().toLowerCase();
    var model = String(bill["Vehicle Model"] || "").trim().toLowerCase();
    var colour = String(bill["Vehicle Colour"] || "").trim().toLowerCase();
    var match = -1;
    if (chassis) match = stocks.findIndex(function(stock, index) { return !soldIndexes[index] && String(stock["Chassis No"] || "").trim().toLowerCase() === chassis; });
    if (match < 0 && !chassis && company && model) match = stocks.findIndex(function(stock, index) {
      return !soldIndexes[index] && (!company || String(stock["Vehicle Company"] || "").trim().toLowerCase() === company) && (!model || String(stock["Vehicle Model"] || "").trim().toLowerCase() === model) && (!colour || String(stock["Vehicle Colour"] || "").trim().toLowerCase() === colour);
    });
    if (match >= 0) soldIndexes[match] = true;
  });
  return stocks.filter(function(stock, index) { return !soldIndexes[index]; });
}
function consumeVehicleStockForBill(data, authBranch) {
  if (String(data.item || "").trim().toLowerCase().indexOf("scooty") === -1) return false;
  var chassisNo = String(data.chassisNo || "").trim().toLowerCase();
  var sheet = ensureVehicleStockSheet(SpreadsheetApp.getActiveSpreadsheet());
  var rows = sheet.getDataRange().getDisplayValues();
  var headers = rows[0].map(function(header) { return String(header).trim(); });
  var index = {chassis:headers.indexOf("Chassis No"), company:headers.indexOf("Vehicle Company"), model:headers.indexOf("Vehicle Model"), colour:headers.indexOf("Vehicle Colour"), branch:headers.indexOf("Branch")};
  for (var i = 1; i < rows.length; i++) {
    var row = rows[i];
    var sameBranch = isMainBranch(authBranch) || normalizeBranch(row[index.branch]) === authBranch;
    var sameChassis = chassisNo && String(row[index.chassis] || "").trim().toLowerCase() === chassisNo;
    var sameVehicle = data.vehicleCompany && data.vehicleModel && String(row[index.company] || "").trim().toLowerCase() === String(data.vehicleCompany).trim().toLowerCase() && String(row[index.model] || "").trim().toLowerCase() === String(data.vehicleModel).trim().toLowerCase() && (!data.vehicleColour || String(row[index.colour] || "").trim().toLowerCase() === String(data.vehicleColour).trim().toLowerCase());
    if ((sameChassis || (!chassisNo && sameVehicle)) && sameBranch) {
      sheet.deleteRow(i + 1);
      return true;
    }
  }
  if (chassisNo) {
    for (var j = 1; j < rows.length; j++) {
      var fallback = rows[j];
      var sameBranchFallback = isMainBranch(authBranch) || normalizeBranch(fallback[index.branch]) === authBranch;
      var sameVehicleFallback = data.vehicleCompany && data.vehicleModel && String(fallback[index.company] || "").trim().toLowerCase() === String(data.vehicleCompany).trim().toLowerCase() && String(fallback[index.model] || "").trim().toLowerCase() === String(data.vehicleModel).trim().toLowerCase() && (!data.vehicleColour || String(fallback[index.colour] || "").trim().toLowerCase() === String(data.vehicleColour).trim().toLowerCase());
      if (sameVehicleFallback && sameBranchFallback) { sheet.deleteRow(j + 1); return true; }
    }
  }
  return false;
}

